default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "8RTWXH9MN9",
      issuer_id: "274b012d-e779-4150-bc2d-65f2b44f6f27",
      key_filepath: "~/.appstoreconnect/private_keys/AuthKey_8RTWXH9MN9.p8",
      duration: 1200,
      in_house: false
    )

    # Build/marketing version are set by hand in project.yml (kept in sync with
    # docs/release-notes-buildN.md) rather than auto-incremented here - an
    # auto-increment would drift the shipped build number away from the "buildN"
    # the release notes and CURRENT_PROJECT_VERSION agree on.

    build_app(
      scheme: "Fable",
      workspace: nil,
      project: "Fable.xcodeproj",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
